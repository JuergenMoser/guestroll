# Every variable is optional. Full reference: docs/configuration.md
# Copy to `.env` and adjust: `docker compose` reads it automatically.

# ─── Docker / network ─────────────────────────────────────────────
# Port published on the host, and the interface it listens on.
HOST_PORT=3000
HOST_BIND=0.0.0.0
# Port the server listens on inside the container (or on the machine without Docker).
PORT=3000
# Interface the server binds to inside the container.
HOSTNAME=0.0.0.0
# Where photos and the database live on the host: a named volume or a path (./data).
DATA_PATH=guestroll-data
# Owner of the data folder. Match your host user for bind mounts (`id -u`, `id -g`).
PUID=1001
PGID=1001
# Time zone used for stats (hourly and daily buckets). Example: Europe/Paris
TZ=UTC
# Image and container name, to pin a version or run several instances.
GUESTROLL_IMAGE=ghcr.io/achedon12/guestroll:latest
CONTAINER_NAME=guestroll

# ─── Instance ─────────────────────────────────────────────────────
APP_NAME=Guestroll
# Public origin encoded in QR codes. Falls back to the request host when empty.
PUBLIC_URL=
# en | fr | it | es. Language used when nothing more specific applies.
# Order: the visitor's own choice > the album's language > the browser's language > DEFAULT_LOCALE.
DEFAULT_LOCALE=en
# false: skip the browser's language and go straight to DEFAULT_LOCALE.
DETECT_BROWSER_LOCALE=true
# Data folder inside the container. Leave as is with Docker.
DATA_DIR=/data

# ─── Security ─────────────────────────────────────────────────────
# The owner account created on first start. Other accounts are added from the admin.
ADMIN_USERNAME=admin
# Its password. When empty, one is generated on first boot and printed in the logs.
ADMIN_PASSWORD=
# 32+ characters. When empty, one is generated and stored in DATA_DIR.
SESSION_SECRET=
# Trust X-Forwarded-For / X-Forwarded-Host. Only behind a reverse proxy you control.
TRUST_PROXY=false
# true in production. Set to false only to test over plain HTTP.
SECURE_COOKIES=true
# Webhooks only reach public addresses. For a ntfy or Home Assistant on your own network:
# WEBHOOK_ALLOW_PRIVATE=true
# Same for the cloud export, for a Nextcloud on your own network:
# CLOUD_ALLOW_PRIVATE=true

# ─── Uploads ──────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
MAX_IMAGE_MEGAPIXELS=80
# For events that accept videos (off by default, per event)
MAX_VIDEO_MB=200
MAX_VIDEO_SECONDS=60
# camera | picker | both — capture mode preselected for new events
DEFAULT_CAPTURE_MODE=camera

# ─── Rate limits (per minute) ─────────────────────────────────────
RATE_LIMIT_UPLOADS_PER_MINUTE=30
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_UNLOCK_PER_MINUTE=10

# ─── Storage ──────────────────────────────────────────────────────
# local: photos in DATA_DIR. s3: any S3-compatible bucket (the database stays in DATA_DIR).
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Folder inside the bucket, to share it between instances.
S3_PREFIX=
# false for AWS virtual-hosted style (bucket.endpoint)
S3_FORCE_PATH_STYLE=true

# ─── Scheduled backups (optional) ─────────────────────────────────
# e.g. 0 3 * * * for every night at 3:00 (in TZ). Settable in the admin otherwise.
BACKUP_CRON=
BACKUP_KEEP=7
# Another disk is best: a backup next to the photos doesn't survive that disk.
BACKUP_DIR=
# Or an S3-compatible bucket (not the photos' bucket):
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=

# ─── Updates ──────────────────────────────────────────────────────
# Check GitHub for new releases every 12 hours and tell the owners.
UPDATE_CHECK=true
# One-click updates from the admin: start the updater too
#   docker compose --profile updater up -d
# and set a long random token (openssl rand -hex 32), shared by both containers.
UPDATER_URL=
UPDATER_TOKEN=

# ─── Email (optional) ─────────────────────────────────────────────
# Setting SMTP_HOST turns email on and locks the admin's SMTP form.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Sender, e.g. Guestroll <photos@example.com>. Defaults to SMTP_USER.
SMTP_FROM=
# A login is only sent over TLS (implicit or STARTTLS). For a relay on the same
# machine or a trusted network that has no TLS at all:
# SMTP_ALLOW_PLAIN=true
# Alerts and event summaries go here.
ADMIN_EMAIL=
# Background worker: mail queue, scheduled closings, alerts. 0 disables it.
SCHEDULER_INTERVAL_SECONDS=60

# Prometheus metrics at /api/metrics, behind this bearer token (16+ characters):
# METRICS_TOKEN=

# Single sign-on (OpenID Connect): on when the three are set.
# OIDC_ISSUER=https://auth.example.com/application/o/guestroll
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Authentik
# OIDC_AUTO_CREATE=false

# Every variable is optional. Full reference: docs/configuration.md
# Copy to `.env` and adjust: `docker compose` reads it automatically.

# ─── Docker / network ─────────────────────────────────────────────
# Port published on the host, and the interface it listens on.
HOST_PORT=3000
HOST_BIND=0.0.0.0
# Port the server listens on inside the container (or on the machine without Docker).
PORT=3000
# Interface the server binds to inside the container.
HOSTNAME=0.0.0.0
# Where photos and the database live on the host: a named volume or a path (./data).
DATA_PATH=guestroll-data
# Owner of the data folder. Match your host user for bind mounts (`id -u`, `id -g`).
PUID=1001
PGID=1001
# Time zone used for stats (hourly and daily buckets). Example: Europe/Paris
TZ=UTC
# Image and container name, to pin a version or run several instances.
GUESTROLL_IMAGE=ghcr.io/achedon12/guestroll:latest
CONTAINER_NAME=guestroll

# ─── Instance ─────────────────────────────────────────────────────
APP_NAME=Guestroll
# Public origin encoded in QR codes. Falls back to the request host when empty.
PUBLIC_URL=
# en | fr | it | es. Language used when nothing more specific applies.
# Order: the visitor's own choice > the album's language > the browser's language > DEFAULT_LOCALE.
DEFAULT_LOCALE=en
# false: skip the browser's language and go straight to DEFAULT_LOCALE.
DETECT_BROWSER_LOCALE=true
# Data folder inside the container. Leave as is with Docker.
DATA_DIR=/data

# ─── Security ─────────────────────────────────────────────────────
# Admin password. When empty, one is generated on first boot and printed in the logs.
ADMIN_PASSWORD=
# 32+ characters. When empty, one is generated and stored in DATA_DIR.
SESSION_SECRET=
# Trust X-Forwarded-For / X-Forwarded-Host. Only behind a reverse proxy you control.
TRUST_PROXY=false
# true in production. Set to false only to test over plain HTTP.
SECURE_COOKIES=true

# ─── Uploads ──────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
MAX_IMAGE_MEGAPIXELS=80
# camera | picker | both — capture mode preselected for new events
DEFAULT_CAPTURE_MODE=camera

# ─── Rate limits (per minute) ─────────────────────────────────────
RATE_LIMIT_UPLOADS_PER_MINUTE=30
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_UNLOCK_PER_MINUTE=10

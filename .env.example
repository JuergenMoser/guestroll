# Every variable is optional. See docs/configuration.md for details.

# --- Instance ---
APP_NAME=Guestroll
# Public origin encoded in QR codes. Falls back to the request host when empty.
PUBLIC_URL=
# en | fr
DEFAULT_LOCALE=en
# Where the SQLite database and photos live. /data in the Docker image.
DATA_DIR=./data

# --- Security ---
# Admin password. When empty, one is generated on first boot and printed in the logs.
ADMIN_PASSWORD=
# 32+ characters. When empty, one is generated and stored in DATA_DIR.
SESSION_SECRET=
# Trust X-Forwarded-For / X-Forwarded-Host. Only behind a reverse proxy you control.
TRUST_PROXY=false
# Defaults to true in production. Set to false only for plain-HTTP testing.
SECURE_COOKIES=

# --- Uploads ---
MAX_UPLOAD_MB=25
MAX_IMAGE_MEGAPIXELS=80
# camera | picker | both — default for new events
DEFAULT_CAPTURE_MODE=camera

# --- Rate limits (per minute) ---
RATE_LIMIT_UPLOADS_PER_MINUTE=30
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_UNLOCK_PER_MINUTE=10
